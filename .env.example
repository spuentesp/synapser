# Copy to .env (git-ignored). Never commit real values.
NEBIUS_API_KEY=          # Nebius Token Factory (NEBIUS_TOKEN / NEMOTRON_TOKEN are accepted aliases)
LANGSMITH_KEY=           # optional: LangSmith export (src/audit/langsmith.ts); LANGSMITH_API_KEY also accepted
NEBIUS_PROJECT_ID=       # only needed for Sandboxes
TAVILY_API_KEY=          # tvly-... (TAVILY_TOKEN is an accepted alias)
