{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/library/agent-rules.test.ts test/library/references.test.ts test/library/validation-golden.test.ts test/library/decimals.test.ts test/library/validate.survivors.test.ts"
  },
  "mutate": [
    "src/library/validate.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 1,
  "timeoutMS": 180000,
  "tempDirName": ".stryker-tmp-library",
  "cleanTempDir": true,
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "evidence/mutation/library.json"
  },
  "thresholds": {
    "high": 98,
    "low": 95,
    "break": null
  }
}
