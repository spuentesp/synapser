{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/executor/protocol.test.ts"
  },
  "mutate": [
    "src/executor/executor.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp-executor",
  "cleanTempDir": true,
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "evidence/mutation/executor.json"
  },
  "thresholds": {
    "high": 98,
    "low": 95,
    "break": null
  },
  "ignorePatterns": [
    "evidence/**",
    ".stryker-tmp*/**"
  ]
}
