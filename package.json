{
  "name": "synapser",
  "version": "0.0.1",
  "private": true,
  "description": "Supervised multi-agent execution on top of Zoanthrope",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build",
    "web:dev": "npm --prefix web run dev",
    "demo": "node scripts/demo.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "gate:g0": "node scripts/gate-g0.ts",
    "test:live": "node --env-file=.env --test --test-reporter=spec \"test/live/**/*.test.ts\"",
    "verify": "node scripts/verify.ts",
    "test:contract": "node --test --test-reporter=spec \"test/contract/**/*.test.ts\"",
    "test:coverage": "mkdir -p evidence/coverage && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=evidence/coverage/lcov.info \"test/**/*.test.ts\"",
    "contracts:update": "node scripts/contracts-update.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "4.10.2",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "undici": "8.11.2",
    "zod": "4.6.7"
  }
}
